{
  "model": {
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 2,
    "d_ff": 512,
    "max_seq_len": 128,
    "dropout": 0.0,
    "use_rope": true,
    "tie_weights": true,
    "use_gradient_checkpointing": false
  },
  "training": {
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "epochs": 1,
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "warmup_steps": 5,
    "min_lr_ratio": 0.1,
    "save_every": 1,
    "log_every": 1,
    "num_workers": 0,
    "prefetch_factor": 2,
    "seed": 42,
    "use_fp16": false,
    "use_compile": false,
    "fused_optimizer": false,
    "ce_chunk_rows": 256,
    "target_tokens": 512,
    "max_micro_batch": 8,
    "test_samples": 1000,
    "prepend_bos": true,
    "append_eos": true,
    "max_steps": 0
  },
  "tokenizer": {
    "vocab_size": 2048,
    "path": "tokenizer.json",
    "max_bytes": 2000000,
    "min_frequency": 1
  },
  "paths": {
    "data_dir": "data",
    "cache_dir": "cache",
    "checkpoint_dir": "checkpoints"
  }
}
