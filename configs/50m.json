{
  "model": {
    "d_model": 512,
    "n_heads": 8,
    "n_layers": 8,
    "d_ff": 2048,
    "max_seq_len": 2048,
    "dropout": 0.1,
    "use_rope": true,
    "tie_weights": true,
    "use_gradient_checkpointing": false
  },
  "training": {
    "batch_size": 64,
    "gradient_accumulation_steps": 1,
    "epochs": 1,
    "learning_rate": 0.0004,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "warmup_steps": 2000,
    "min_lr_ratio": 0.15,
    "save_every": 1,
    "log_every": 50,
    "num_workers": 8,
    "prefetch_factor": 4,
    "seed": 42,
    "use_fp16": true,
    "use_compile": true,
    "fused_optimizer": true,
    "ce_chunk_rows": 2048,
    "target_tokens": 12288,
    "max_micro_batch": 64,
    "test_samples": 100000,
    "prepend_bos": true,
    "append_eos": true,
    "max_steps": 0
  },
  "tokenizer": {
    "vocab_size": 65536,
    "path": "tokenizer.json",
    "max_bytes": 300000000,
    "min_frequency": 2
  },
  "paths": {
    "data_dir": "data",
    "cache_dir": "cache",
    "checkpoint_dir": "checkpoints"
  }
}
